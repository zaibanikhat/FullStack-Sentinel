              {
                "key": "X-API-Key",
                "value": "09306da2de728c5a069d392ad62ed7fa"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/api/customer/cust_836/transactions?from=2023-01-01&to=2023-12-31&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "customer", "cust_836", "transactions"],
              "query": [
                {
                  "key": "from",
                  "value": "2023-01-01"
                },
                {
                  "key": "to",
                  "value": "2023-12-31"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
