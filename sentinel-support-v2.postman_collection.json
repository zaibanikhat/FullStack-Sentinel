    {
      "name": "6. Knowledge Base",
      "item": [
        {
          "name": "Search KB",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "09306da2de728c5a069d392ad62ed7fa"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/kb/search?q=payments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "kb", "search"],
              "query": [
