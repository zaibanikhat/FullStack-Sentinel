              },
              {
                "key": "X-API-Key",
                "value": "09306da2de728c5a069d392ad62ed7fa"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp_1761800034279"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"txn_199999\",\n    \"customerId\": \"cust_836\",\n    \"cardId\": \"card_5bh7ya071\",\n    \"accountId\": \"acc_836\",\n    \"amount\": \"890.48\",\n    \"currency\": \"USD\",\n    \"merchant\": \"Merchant 1\",\n    \"category\": \"bills\",\n    \"status\": \"failed\",\n    \"timestamp\": \"2023-04-26T18:20:42.601Z\",\n    \"isFraud\": false\n  }\n]"
            },
            "url": {
              "raw": "http://localhost:3001/api/ingest/transactions",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "ingest", "transactions"]
            }
          }
        },
        {
          "name": "Get Customer Transactions",
          "request": {
            "method": "GET",
