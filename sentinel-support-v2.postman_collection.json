                "key": "X-API-Key",
                "value": "09306da2de728c5a069d392ad62ed7fa"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get Metrics",
          "request": {
            "method": "GET",
